    <!-- Foreground notification -->
    <string name="notif_title">Husk</string>
    <string name="notif_text">Camera and recovery active</string>
    <string name="notif_channel_camera">Camera</string>
    <string name="notif_channel_screen">Screen sharing</string>

    <!-- Status -->
    <string name="status_heading">Status</string>
    <string name="status_engine">Automation engine (accessibility)</string>
    <string name="status_camera">Camera</string>
    <string name="status_on">on</string>
    <string name="status_off">off</string>

    <!-- Toggles -->
    <string name="toggle_camera">Camera streaming</string>
    <string name="toggle_dex">Keep Samsung DeX connected</string>
    <string name="toggle_wd">Wireless-debugging recovery</string>
    <string name="toggle_boot">Start automatically after reboot</string>

    <!-- Settings deep-links -->
    <string name="settings_heading">Open required settings</string>
    <string name="btn_accessibility">Accessibility (enable Husk)</string>
    <string name="btn_devoptions">Developer options / Wireless debugging</string>
    <string name="btn_battery">Battery optimisation (allow)</string>
    <string name="btn_appdetails">App permissions</string>
    <string name="btn_enabledev">Unlock Developer options (automatic)</string>
    <string name="btn_aboutphone">About phone (manual)</string>
    <string name="devhint">Needed only for PC screen mirroring. Husk can unlock Developer options for you (it taps Build number automatically, like it re-enables Wireless debugging). If your phone asks for a PIN/pattern, do that one step by hand.</string>
    <string name="need_a11y">Enable the Husk accessibility service first (Accessibility button above).</string>
    <string name="dev_working">Working - opening About phone and tapping Build number...</string>
    <string name="dev_ok">Developer options unlocked.</string>
    <string name="dev_fail">Could not unlock automatically - if your phone asked for a PIN, open About phone and tap Build number 7 times by hand.</string>
    <string name="setting_unavailable">Not available on this device</string>

    <!-- Companion -->
    <string name="companion_heading">PC companion (screen mirroring)</string>
    <string name="companion_explain">To mirror and control this phone from a PC, install the small companion from:</string>
    <string name="companion_url">xplat.co/husk</string>
    <string name="btn_get_companion">Get the PC companion</string>

    <!-- Screen sharing (MediaProjection) -->
    <string name="btn_screenshare">Start screen sharing (browser)</string>
    <string name="screen_on">Screen sharing on - open http://PHONE-IP:8090/control on a PC (same Tailscale network).</string>
    <string name="screen_cancel">Screen sharing cancelled.</string>
    <string name="status_screen">Screen sharing</string>
    <string name="toggle_screen">Screen sharing (keep on)</string>
    <string name="screen_hint">View + control this phone from a browser at http://PHONE-IP:8090/control. Stays on across reboots; the accessibility engine grants it automatically.</string>

    <!-- IP display -->
    <string name="status_local_ip">Local IP</string>
    <string name="status_ts_ip">Tailscale IP</string>

