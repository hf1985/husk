    <string name="motion_heading">Motion alerts (security camera)</string>
    <string name="toggle_motion">Motion alerts</string>
    <string name="motion_topic_hint">ntfy topic (e.g. husk-mit-hjem-7f3k)</string>
    <string name="motion_hint">Turns this phone into a free, private security camera: when it sees movement it sends a push to your ntfy topic with a live snapshot. Install the ntfy app and subscribe to the same topic.</string>
    <string name="motion_on">Motion alerts on.</string>
    <string name="motion_off">Motion alerts off.</string>
    <!-- Push text sent to the user's ntfy topic. Was hardcoded Danish until 1.0. -->
    <string name="ntfy_title">Husk: motion detected</string>
    <string name="ntfy_msg_camera">The camera detected movement (%1$d%% change)</string>
    <string name="ntfy_msg_screen">The screen detected movement (%1$d%% change)</string>

    <!-- Access token (1.4): set here or via /token/request with approval on the phone -->
    <string name="token_heading">Access token</string>
    <string name="token_field_hint">Token (empty = no token)</string>
    <string name="token_show">Show</string>
    <string name="token_generate">Generate</string>
    <string name="token_copy">Copy</string>
    <string name="token_save">Save</string>
